generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  RECRUITING
  ACTIVE
  COMPLETED
}

enum ProjectVisibility {
  PUBLIC
  PRIVATE
}

enum ActivityType {
  MEMBER_JOINED
  MEMBER_REMOVED
  TASK_CREATED
  TASK_COMPLETED
  MILESTONE_CREATED
  MILESTONE_COMPLETED
  PROJECT_COMPLETED
}

enum ApplicationStatus {
  PENDING       // submitted, awaiting owner review
  ACCEPTED      // owner accepted, awaiting applicant confirmation
  CONFIRMED     // applicant confirmed -> becomes a Membership
  REJECTED
  WITHDRAWN
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum ProjectStage {
  IDEA
  PLANNING
  MVP
  BETA
  LIVE
  COMPLETED
  ARCHIVED
}

enum ProjectType {
  STARTUP
  OPEN_SOURCE
  SIDE_PROJECT
  HACKATHON
  RESEARCH
  COMMUNITY
  EXPERIMENTAL
}

enum CommitmentType {
  VOLUNTEER
  EQUITY
  PAID
  MIXED
}

enum ExperienceLevel {
  ANY
  JUNIOR
  MID
  SENIOR
}

enum AvailabilityBand {
  HOURS_5_10
  HOURS_10_20
  HOURS_20_40
  FULL_TIME
}

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  password      String
  name          String?
  headline      String?
  bio           String?
  skills        String?   // legacy comma-separated tags, kept for existing data; new tagging uses UserSkill
  githubUrl     String?
  portfolioUrl  String?
  linkedinUrl   String?
  websiteUrl    String?
  location      String?
  timezone      String?
  profilePic    String?
  openToProjects   Boolean @default(false)
  openToCofounder  Boolean @default(false)
  openToFreelance  Boolean @default(false)
  openToEmployment Boolean @default(false)
  availability     AvailabilityBand?
  isAdmin       Boolean   @default(false)
  isBanned      Boolean   @default(false)
  isRemoved     Boolean   @default(false)
  lastActiveAt  DateTime?
  createdAt     DateTime  @default(now())

  ownedProjects Project[]      @relation("ProjectOwner")
  applications  Application[]
  memberships   Membership[]
  assignedTasks Task[]         @relation("TaskAssignee")
  messages      Message[]
  userSkills    UserSkill[]
  uploadedFiles ProjectFile[]
  reviewsGiven    Review[] @relation("ReviewsGiven")
  reviewsReceived Review[] @relation("ReviewsReceived")
  activities      Activity[]
  resetTokens     PasswordResetToken[]
  // completedProjects, responseRate, averageRating are intentionally NOT
  // stored here - they're computed on read in userStats.js from actual
  // project/application/membership/review data, same as Role.filledSlots. A
  // stored counter needs something to update it on every relevant event; a
  // computed value can never go stale.
}

model Project {
  id          Int               @id @default(autoincrement())
  title       String
  description String
  category    String?
  status      ProjectStatus     @default(RECRUITING) // drives recruitment/workspace logic - open for applications, active, done
  stage       ProjectStage      @default(IDEA)        // descriptive product maturity, independent of `status`
  type        ProjectType?
  commitment  CommitmentType?
  visibility  ProjectVisibility @default(PUBLIC) // owner's choice once COMPLETED
  ownerId     Int
  owner       User              @relation("ProjectOwner", fields: [ownerId], references: [id])
  repoUrl     String?           // linked GitHub repo - we show read-only activity from it, we don't host code ourselves
  createdAt   DateTime          @default(now())

  roles       Role[]
  applications Application[]
  memberships Membership[]
  tasks       Task[]
  messages    Message[]
  files       ProjectFile[]
  reviews     Review[]
  milestones  Milestone[]
  activities  Activity[]
}

model ProjectFile {
  id         Int      @id @default(autoincrement())
  projectId  Int
  project    Project  @relation(fields: [projectId], references: [id])
  uploaderId Int
  uploader   User     @relation(fields: [uploaderId], references: [id])
  filename   String   // original filename shown to users
  storedName String   // randomized name actually used on disk, avoids collisions/overwrites
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())
}

model Role {
  id          Int           @id @default(autoincrement())
  projectId   Int
  project     Project       @relation(fields: [projectId], references: [id])
  name        String        // e.g. "Backend dev"
  description String?
  experience  ExperienceLevel @default(ANY)
  commitment  CommitmentType?
  slots       Int           @default(1) // total slots for this role
  createdAt   DateTime      @default(now())

  applications Application[]
  memberships Membership[]
  roleSkills  RoleSkill[]
  // filled count = memberships.length for this role, computed in API, not stored
}

model RoleSkill {
  roleId  Int
  skillId Int
  level   Int   @default(3) // 1-5 minimum proficiency the role is looking for

  role    Role  @relation(fields: [roleId], references: [id])
  skill   Skill @relation(fields: [skillId], references: [id])

  @@id([roleId, skillId])
}

model Application {
  id          Int               @id @default(autoincrement())
  projectId   Int
  project     Project           @relation(fields: [projectId], references: [id])
  roleId      Int
  role        Role              @relation(fields: [roleId], references: [id])
  userId      Int
  user        User              @relation(fields: [userId], references: [id])
  message     String?           // optional note from applicant
  status      ApplicationStatus @default(PENDING)
  createdAt   DateTime          @default(now())

  @@unique([roleId, userId]) // one application per user per role
}

model Membership {
  id          Int       @id @default(autoincrement())
  projectId   Int
  project     Project   @relation(fields: [projectId], references: [id])
  roleId      Int
  role        Role      @relation(fields: [roleId], references: [id])
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  joinedAt    DateTime  @default(now())
  active      Boolean   @default(true) // false if removed/left this specific role

  @@unique([roleId, userId]) // a person can hold multiple roles on a project, never the same role twice
}

model Task {
  id          Int         @id @default(autoincrement())
  projectId   Int
  project     Project     @relation(fields: [projectId], references: [id])
  title       String
  description String?
  status      TaskStatus  @default(TODO)
  assigneeId  Int?
  assignee    User?       @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdAt   DateTime    @default(now())
}

model Message {
  id        Int      @id @default(autoincrement())
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id])
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

model Skill {
  id         Int         @id @default(autoincrement())
  name       String      @unique
  createdAt  DateTime    @default(now())
  userSkills UserSkill[]
  roleSkills RoleSkill[]
}

model UserSkill {
  userId  Int
  skillId Int
  level   Int    @default(3) // 1-5 self-rated proficiency

  user    User   @relation(fields: [userId], references: [id])
  skill   Skill  @relation(fields: [skillId], references: [id])

  @@id([userId, skillId])
}

model Review {
  id         Int      @id @default(autoincrement())
  projectId  Int
  project    Project  @relation(fields: [projectId], references: [id])
  reviewerId Int
  reviewer   User     @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  revieweeId Int
  reviewee   User     @relation("ReviewsReceived", fields: [revieweeId], references: [id])
  rating     Int      // 1-5 stars
  comment    String?
  createdAt  DateTime @default(now())

  @@unique([projectId, reviewerId, revieweeId]) // one review per teammate per project
}

model Milestone {
  id          Int       @id @default(autoincrement())
  projectId   Int
  project     Project   @relation(fields: [projectId], references: [id])
  title       String
  description String?
  order       Int       @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
}

model Activity {
  id        Int          @id @default(autoincrement())
  projectId Int
  project   Project      @relation(fields: [projectId], references: [id])
  actorId   Int
  actor     User         @relation(fields: [actorId], references: [id])
  type      ActivityType
  message   String       // precomputed human-readable text, e.g. "Sarah joined as Designer"
  createdAt DateTime     @default(now())
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime  @default(now())
}
