# Required
DATABASE_URL="postgresql://user:password@host:5432/ideablend?schema=public"
JWT_SECRET="change-me-to-a-random-string-of-at-least-32-characters"
NODE_ENV="development"
PORT=4000
FRONTEND_URL="http://localhost:5173"

# Comma-separated extra origins allowed to call the API (Vercel preview URLs
# and localhost are already allowed). Example:
# CORS_ORIGINS="https://ideablend.vercel.app"
CORS_ORIGINS=""

# Durable object storage - required in production on hosts with an ephemeral
# filesystem (Render, Railway), otherwise avatars/project files vanish on the
# next deploy. Create two Supabase Storage buckets: one PUBLIC for avatars,
# one PRIVATE for project files. Leave unset to use local disk in development.
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_AVATAR_BUCKET="avatars"
# SUPABASE_FILE_BUCKET="project-files"

# Optional but recommended in production
# ANTHROPIC_API_KEY="sk-ant-..."
# AGENT_MODEL="claude-haiku-4-5-20251001"
# GITHUB_TOKEN="ghp_..."            # raises GitHub API limit from 60 to 5000 req/hr
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="Idea Blend <no-reply@example.com>"
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:admin@example.com"
